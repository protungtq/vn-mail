{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    },
    "windows": [
      {
        "height": 760,
        "minHeight": 600,
        "minWidth": 900,
        "title": "VN Mail",
        "visible": false,
        "width": 1200
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "homepage": "https://so1.asia",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {},
      "deb": {
        "desktopTemplate": "vnmail.desktop"
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ],
        "desktopTemplate": "vnmail.desktop"
      }
    },
    "longDescription": "VN Mail is a mail app for Gmail and any IMAP account. It keeps your mail in an encrypted database on your own computer, removes trackers and warns about suspicious messages.",
    "publisher": "TungTQ",
    "shortDescription": "A modern, open-source mail app",
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ]
  },
  "identifier": "asia.so1.vnmail",
  "productName": "VN Mail",
  "version": "0.1.13"
}
